# Destino de la API. Segun donde corra la app:
#   emulador Android         -> http://10.0.2.2:8000/api
#   simulador iOS, escritorio, web -> http://localhost:8000/api
#   dispositivo fisico       -> http://<IP-LAN-del-PC>:8000/api
API_BASE_URL=http://localhost:8000/api
API_TIMEOUT_MS=15000
LOG_HTTP=true

# Tenant de Auth0. Ninguno es secreto: PKCE no usa client secret.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_SCHEME=glucy
